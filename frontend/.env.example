# Bano.ai - Lecture Intelligence Environment Variables

# The backend FastAPI server base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Auth mode: dev | firebase
NEXT_PUBLIC_AUTH_MODE=dev

# Mock API toggle: set to false to use real backend API
NEXT_PUBLIC_USE_MOCK_API=false

# Mock scenario for development testing: default | empty | slow | errors | benchmark-sample
NEXT_PUBLIC_MOCK_SCENARIO=default

# Firebase configuration (Required when NEXT_PUBLIC_AUTH_MODE=firebase)
# Never commit real credentials; define them in .env.local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
